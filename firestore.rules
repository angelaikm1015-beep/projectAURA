rules_version = '2';

// Profile documents are written only by the Flask backend, which uses the
// Firebase Admin SDK and bypasses these rules. Clients get read access to their
// own document and nothing else, so a compromised browser can't forge a profile.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Saved scores are read and written only through the Flask API, which checks
    // ownership before it shares, unshares or deletes anything. Denying the
    // client outright means a browser can't flip someone else's piece to public
    // or read a private one by guessing its id.
    match /scores/{scoreId} {
      allow read, write: if false;
    }

    // Likes, saves and comments go through the Flask API too, which checks the
    // piece is visible to the reader before it writes anything.
    match /reactions/{reactionId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
