# Copy to backend/.env and fill in. Never commit the real .env or the key file.

# Path to your Firebase service-account JSON, absolute or relative to backend/.
# Firebase console > Project settings > Service accounts > Generate new private key.
FIREBASE_CREDENTIALS=serviceAccountKey.json

# Optional — only needed if the key file doesn't carry the project id.
# FIREBASE_PROJECT_ID=your-project-id

# Comma-separated origins allowed to call /api/*. Add your frontend's origin if
# you serve it separately from Flask. 5173 is the Vite dev server.
ALLOWED_ORIGINS=http://localhost:5001,http://localhost:5173

HOST=127.0.0.1
PORT=5001
FLASK_DEBUG=1
